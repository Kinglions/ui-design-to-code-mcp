{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ui-design-to-code/schemas/target-layout-android-view.schema.json",
  "title": "Android View Target Layout IR",
  "type": "object",
  "required": ["artifactType", "target", "sourceId", "rootLayout", "views"],
  "properties": {
    "artifactType": { "type": "string", "const": "target_layout_ir" },
    "target": { "type": "string", "const": "android-view" },
    "sourceId": { "type": "string", "minLength": 1 },
    "rootLayout": { "type": "string", "minLength": 1 },
    "stateModel": { "type": "object", "required": ["states"], "additionalProperties": true },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sourceNodeId", "viewClass", "layoutParams", "attributes", "accessibility"],
        "properties": {
          "id": { "type": "string" },
          "sourceNodeId": { "type": "string" },
          "viewClass": { "type": "string" },
          "xmlId": { "type": "string" },
          "layoutParams": { "type": "object", "additionalProperties": true },
          "attributes": { "type": "object", "additionalProperties": true },
          "listeners": { "type": "object", "additionalProperties": true },
          "accessibility": { "type": "object", "additionalProperties": true },
          "children": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "assets": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "reviewChecks": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
