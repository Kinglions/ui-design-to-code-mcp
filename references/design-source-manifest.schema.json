{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ui-design-to-code/schemas/design-source-manifest.schema.json",
  "title": "Design Source Manifest",
  "type": "object",
  "required": ["artifactType", "source", "inputs", "coordinateSpaces", "uncertainties"],
  "properties": {
    "artifactType": { "type": "string", "const": "design_source_manifest" },
    "source": {
      "type": "object",
      "required": ["id", "sourceKind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "sourceKind": { "type": "string", "enum": ["image", "figma", "hybrid"] },
        "name": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "additionalProperties": true
    },
    "inputs": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "widthPx": { "type": "number", "exclusiveMinimum": 0 },
            "heightPx": { "type": "number", "exclusiveMinimum": 0 },
            "colorSpace": { "type": "string" }
          },
          "additionalProperties": true
        },
        "figma": {
          "type": "object",
          "properties": {
            "fileKey": { "type": "string" },
            "nodeId": { "type": "string" },
            "frameId": { "type": "string" },
            "nodeJsonPath": { "type": "string" },
            "screenshotPath": { "type": "string" },
            "source": { "type": "string", "enum": ["figma_mcp", "figma_rest", "manual_export", "unknown"] }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "coordinateSpaces": {
      "type": "object",
      "required": ["sourcePixel", "figmaCanvas", "logical"],
      "properties": {
        "sourcePixel": {
          "type": "object",
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "origin": { "type": "string", "enum": ["top_left"] },
            "unit": { "type": "string", "const": "px" },
            "bounds": { "$ref": "#/$defs/rect" }
          },
          "additionalProperties": true
        },
        "figmaCanvas": {
          "type": "object",
          "required": ["available"],
          "properties": {
            "available": { "type": "boolean" },
            "origin": { "type": "string", "enum": ["top_left"] },
            "unit": { "type": "string", "enum": ["figma_px", "unknown"] },
            "bounds": { "$ref": "#/$defs/rect" }
          },
          "additionalProperties": true
        },
        "logical": {
          "type": "object",
          "required": ["available", "unit", "confidence"],
          "properties": {
            "available": { "type": "boolean" },
            "unit": { "type": "string", "enum": ["pt", "dp", "cssPx", "unknown"] },
            "scaleFromSourcePx": { "type": "number", "minimum": 0 },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
          },
          "additionalProperties": true
        },
        "figmaToSourcePixel": {
          "type": "object",
          "properties": {
            "available": { "type": "boolean" },
            "scaleX": { "type": "number" },
            "scaleY": { "type": "number" },
            "offsetX": { "type": "number" },
            "offsetY": { "type": "number" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "evidence": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "uncertainties": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
