{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ui-design-to-code/schemas/platform-adapter-contract.schema.json",
  "title": "Platform Adapter Contract",
  "type": "object",
  "required": ["adapter", "mappingPriority", "semanticMappings", "layoutCapabilities", "stateMappings", "eventMappings", "accessibilityMappings", "rejectWhen"],
  "properties": {
    "adapter": {
      "type": "object",
      "required": ["id", "name", "platform", "language", "uiRuntime", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "enum": ["ios", "web", "android", "unknown"] },
        "language": { "type": "string", "minLength": 1 },
        "uiRuntime": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "mappingPriority": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "semanticMappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["semanticType", "preferred", "fallbacks", "requiredNodeFields"],
        "properties": {
          "semanticType": { "type": "string", "minLength": 1 },
          "preferred": { "type": "string", "minLength": 1 },
          "fallbacks": { "type": "array", "items": { "type": "string" } },
          "requiredNodeFields": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "layoutCapabilities": {
      "type": "object",
      "required": ["scroll", "fixed", "overlay", "grid", "safeArea", "keyboard"],
      "additionalProperties": true
    },
    "stateMappings": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "eventMappings": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "accessibilityMappings": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "assetHandling": {
      "type": "object",
      "additionalProperties": true
    },
    "reviewPlan": {
      "type": "object",
      "properties": {
        "commands": { "type": "array", "items": { "type": "string" } },
        "runtimeChecks": { "type": "array", "items": { "type": "string" } },
        "visualReview": {
          "type": "object",
          "properties": {
            "capture": { "type": "string" },
            "compare": { "type": "string" },
            "defaultViewports": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["width", "height"],
                "properties": {
                  "width": { "type": "number", "exclusiveMinimum": 0 },
                  "height": { "type": "number", "exclusiveMinimum": 0 },
                  "deviceScaleFactor": { "type": "number", "exclusiveMinimum": 0 },
                  "isMobile": { "type": "boolean" }
                },
                "additionalProperties": true
              }
            },
            "thresholds": {
              "type": "object",
              "properties": {
                "maxPixelDiffRatio": { "type": "number", "minimum": 0, "maximum": 1 },
                "maxMeanChannelDelta": { "type": "number", "minimum": 0, "maximum": 255 },
                "pixelDeltaThreshold": { "type": "number", "minimum": 0, "maximum": 255 },
                "minSimilarity": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": true
            },
            "requiredStateCaptures": { "type": "array", "items": { "type": "string" } },
            "conditionalStateCaptures": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["state", "requiredWhen"],
                "properties": {
                  "state": { "type": "string", "minLength": 1 },
                  "requiredWhen": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": true
              }
            },
            "textOverflowCheck": { "type": "string" },
            "blockedWhen": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "rejectWhen": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
