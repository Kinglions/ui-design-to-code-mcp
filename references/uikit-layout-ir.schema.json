{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ui2uikit/schemas/uikit-layout-ir.schema.json",
  "title": "UIKit Layout IR",
  "type": "object",
  "required": ["viewController", "rootView", "stateModel", "layout", "components"],
  "properties": {
    "viewController": { "type": "string", "minLength": 1 },
    "rootView": { "type": "string", "minLength": 1 },
    "stateModel": {
      "type": "object",
      "required": ["states"],
      "properties": {
        "states": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "layout": {
      "type": "object",
      "required": ["root", "regions"],
      "properties": {
        "root": { "type": "string" },
        "adaptiveLayoutPolicy": {
          "type": "object",
          "properties": {
            "sourceViewport": {
              "type": "object",
              "properties": {
                "width": { "type": "number", "exclusiveMinimum": 0 },
                "height": { "type": "number", "exclusiveMinimum": 0 },
                "deviceClass": { "type": "string" }
              },
              "additionalProperties": true
            },
            "targetViewports": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name", "width", "height"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "width": { "type": "number", "exclusiveMinimum": 0 },
                  "height": { "type": "number", "exclusiveMinimum": 0 },
                  "orientation": { "type": "string", "enum": ["portrait", "landscape"] }
                },
                "additionalProperties": true
              }
            },
            "metrics": {
              "type": "object",
              "description": "Named adaptive constants or token references for compact width, regular width, short height, landscape, Dynamic Type, keyboard, and safe-area states.",
              "additionalProperties": true
            },
            "fixedRegionRules": {
              "type": "array",
              "items": { "type": "string" }
            },
            "keyboardAvoidance": { "type": "string" },
            "dynamicTypeStrategy": { "type": "string" }
          },
          "additionalProperties": true
        },
        "regions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type"],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "semanticType", "iosClass", "mappingReason", "layoutSpec", "visualSpec"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "semanticType": { "type": "string", "minLength": 1 },
          "iosClass": { "type": "string", "minLength": 1 },
          "mappingReason": { "type": "string", "minLength": 1 },
          "layoutSpec": {
            "type": "object",
            "required": ["height", "contentInsets", "interItemSpacing", "slotLayout"],
            "properties": {
              "height": {
                "type": "object",
                "properties": {
                  "mode": { "type": "string", "enum": ["fixed", "min", "intrinsic"] },
                  "token": { "type": "string" },
                  "value": { "type": "number" }
                },
                "additionalProperties": true
              },
              "contentInsets": {
                "type": "object",
                "required": ["top", "bottom", "leading", "trailing"],
                "properties": {
                  "top": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                  "bottom": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                  "leading": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                  "trailing": { "oneOf": [{ "type": "number" }, { "type": "string" }] }
                },
                "additionalProperties": true
              },
              "interItemSpacing": {
                "type": "object",
                "properties": {
                  "vertical": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                  "horizontal": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                  "slotGap": { "oneOf": [{ "type": "number" }, { "type": "string" }] }
                },
                "additionalProperties": true
              },
              "slotLayout": {
                "type": "object",
                "minProperties": 1,
                "additionalProperties": {
                  "type": "object",
                  "required": ["height"],
                  "properties": {
                    "height": {
                      "type": "object",
                      "required": ["mode"],
                      "properties": {
                        "mode": {
                          "type": "string",
                          "enum": ["fixed", "min", "max", "intrinsic", "ratio", "aspectRatio", "fill"]
                        },
                        "token": { "type": "string" },
                        "value": { "type": "number" },
                        "ratio": { "type": "number" },
                        "aspectRatio": {
                          "type": "string",
                          "pattern": "^[0-9]+:[0-9]+$"
                        }
                      },
                      "additionalProperties": true
                    },
                    "spacingAfter": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
                    "constraintTarget": { "type": "string" },
                    "swiftConstant": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          },
          "visualSpec": {
            "type": "object",
            "required": ["cornerRadius", "typography"],
            "properties": {
              "cornerRadius": {
                "type": "object",
                "properties": {
                  "token": { "type": "string" },
                  "value": { "type": "number" }
                },
                "additionalProperties": true
              },
              "typography": {
                "type": "object",
                "properties": {
                  "primaryTextStyle": { "type": "string" },
                  "secondaryTextStyle": { "type": "string" },
                  "tertiaryTextStyle": { "type": "string" }
                },
                "additionalProperties": true
              },
              "backgroundStyle": { "type": "string" },
              "borderStyle": { "type": "string" },
              "shadowStyle": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
