{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ui-design-to-code/schemas/target-layout-cocos-creator.schema.json",
  "title": "Cocos Creator Target Layout IR",
  "type": "object",
  "required": ["artifactType", "target", "sourceId", "rootNode", "nodes", "canvasPolicy"],
  "properties": {
    "artifactType": { "type": "string", "const": "target_layout_ir" },
    "target": { "type": "string", "const": "cocos-creator" },
    "sourceId": { "type": "string", "minLength": 1 },
    "rootNode": { "type": "string", "minLength": 1 },
    "canvasPolicy": {
      "type": "object",
      "required": ["designResolution", "adaptationMode", "orientationPolicy", "safeContentPolicy"],
      "properties": {
        "designResolution": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "number", "exclusiveMinimum": 0 },
            "height": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": true
        },
        "adaptationMode": {
          "type": "string",
          "enum": ["fit_width", "fit_height", "show_all", "no_border", "project_policy"]
        },
        "orientationPolicy": {
          "type": "string",
          "enum": ["portrait", "landscape", "multi_orientation", "project_policy"]
        },
        "safeContentPolicy": {
          "type": "object",
          "required": ["useSafeArea", "fixedControlsInsideSafeContent", "backgroundMayBleed"],
          "properties": {
            "useSafeArea": { "type": "boolean" },
            "fixedControlsInsideSafeContent": { "type": "boolean" },
            "backgroundMayBleed": { "type": "boolean" },
            "insetSource": { "type": "string" }
          },
          "additionalProperties": true
        },
        "aspectRatioBands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "min", "max", "layoutVariant"],
            "properties": {
              "id": { "type": "string" },
              "min": { "type": "number", "exclusiveMinimum": 0 },
              "max": { "type": "number", "exclusiveMinimum": 0 },
              "layoutVariant": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "safeArea": { "type": "string" }
      },
      "additionalProperties": true
    },
    "stateModel": { "type": "object", "required": ["states"], "additionalProperties": true },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sourceNodeId", "nodeName", "parentId", "components", "layout", "visual", "interaction"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceNodeId": { "type": "string", "minLength": 1 },
          "nodeName": { "type": "string", "minLength": 1 },
          "parentId": { "type": ["string", "null"] },
          "components": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "renderableComponent": { "type": "string" },
          "layout": { "type": "object", "required": ["uiTransform"], "additionalProperties": true },
          "visual": { "type": "object", "additionalProperties": true },
          "interaction": { "type": "object", "additionalProperties": true },
          "data": { "type": "object", "additionalProperties": true },
          "accessibility": { "type": "object", "additionalProperties": true },
          "children": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "assets": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "reviewChecks": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
